{
  "layer": "top",
  "position": "top",
  "height": 24,
  "modules-left": [
    "niri/workspaces",
  ],
  "modules-center": [],
  "modules-right": [
    "custom/kernel",
    "pulseaudio",
    "battery",
    "clock"
  ],
  
  "niri/workspaces": {
        "format": "{value}",
  },

  "custom/kernel": {
    "format": "{} 🐧",
    "exec": "uname -r | cut -d '-' -f1",
    "interval": 300
  },

  "pulseaudio": {
    "format": "{volume}% 🔊",
    "format-muted": "muted 🔇"
  },
  
  "battery": {
    "path": "/sys/class/power_supply/BAT0",
    "format": "{capacity}% 🔋",
    "format-charging": "Charging {capacity}% ⚡",
    "format-full": "Full {capacity}% 🔋",
    "format-discharging": "Discharging {capacity}% 🔋"
  },  
     
  "clock": {
    "interval": 60,
    "format": "{:%a %F %H:%M}"
  }
}

